{
  "manifest_version": 3,
  "name": "Shudz - Pinyin Helper",
  "version": "1.5",
  "description": "Adds Pinyin above Chinese characters.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "https://en.wiktionary.org/*" 
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "assets/icon.png"
    }
  },
  "options_page": "library/library.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/pinyin-lib.js",
        "content/content.js"
      ],
      "css": ["content/styles.css"]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/tooltip-template.html"],
      "matches": ["<all_urls>"]
    }
  ]
}
